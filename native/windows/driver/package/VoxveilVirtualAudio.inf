; Voxveil render-only virtual audio driver package.
; Source architecture is derived from Microsoft Windows Driver Samples SysVAD
; revision 67d81f217bc01edf7a4320e4911c11065635acfa under the MS-PL.

[Version]
Signature="$WINDOWS NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=09/14/2026,0.1.0.0
CatalogFile=VoxveilVirtualAudio.cat
PnpLockDown=1

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
VoxveilVirtualAudio.sys=1

[SignatureAttributes]
VoxveilVirtualAudio.sys=SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel=1300

[Manufacturer]
%MfgName%=Voxveil,NTamd64,NTarm64

[Voxveil.NTamd64]
%DeviceName%=Voxveil_Install,Root\VoxveilVirtualAudio

[Voxveil.NTarm64]
%DeviceName%=Voxveil_Install,Root\VoxveilVirtualAudio

[DestinationDirs]
Voxveil.CopyList=13

[Voxveil.CopyList]
VoxveilVirtualAudio.sys

[Voxveil_Install.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=Voxveil.CopyList
AddReg=Voxveil_Install.AddReg

[Voxveil_Install.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,VoxveilVirtualAudio.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%
HKR,Drivers\midi\wdmaud.drv,Description,,%DeviceName%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceName%

[Voxveil_Install.NT.Interfaces]
AddInterface=%VOXVEIL_DEVINTERFACE%,%KSNAME_WaveVoxveil%,Voxveil.I.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveVoxveil%,Voxveil.I.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveVoxveil%,Voxveil.I.Wave
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveVoxveil%,Voxveil.I.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyVoxveil%,Voxveil.I.Topology
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyVoxveil%,Voxveil.I.Topology

[Voxveil.I.Wave]
AddReg=Voxveil.I.Wave.AddReg

[Voxveil.I.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DeviceName%

[Voxveil.I.Topology]
AddReg=Voxveil.I.Topology.AddReg

[Voxveil.I.Topology.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%DeviceName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1
HKR,EP\0,%PKEY_Device_FriendlyName%,,%EndpointName%

[Voxveil_Install.NT.Services]
AddService=VoxveilVirtualAudio,0x00000002,Voxveil_Service_Inst

[Voxveil_Service_Inst]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\VoxveilVirtualAudio.sys
AddReg=Voxveil_Service_Parameters

[Voxveil_Service_Parameters]
HKR,Parameters,DoNotCreateDataFiles,0x00010001,1
HKR,Parameters,DisableToneGenerator,0x00010001,1

[Voxveil_Install.NT.HW]
AddReg=Voxveil.HW.AddReg

[Voxveil.HW.AddReg]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[Voxveil_Install.NT.Wdf]
KmdfService=VoxveilVirtualAudio,Voxveil_WdfSect

[Voxveil_WdfSect]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
ProviderName="Voxveil"
MfgName="Voxveil"
DiskName="Voxveil Virtual Audio Driver Disk"
DeviceName="Voxveil Virtual Audio"
EndpointName="Voxveil Input"
ServiceName="Voxveil Virtual Audio Driver"

VOXVEIL_DEVINTERFACE="{79E4E58C-9714-44E8-ACA1-426F24B7A1E9}"
KSNAME_WaveVoxveil="WaveVoxveil"
KSNAME_TopologyVoxveil="TopologyVoxveil"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
PKEY_Device_FriendlyName="{A45C254E-DF1C-4EFD-8020-67D146A850E0},14"
