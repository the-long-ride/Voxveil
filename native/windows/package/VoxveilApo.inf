[Version]
Signature   = "$WINDOWS NT$"
Class       = AudioProcessingObject
ClassGuid   = {5989fce8-9cd0-467d-8a6a-5419e31529d4}
Provider    = %ProviderName%
DriverVer   = 08/19/2026,1.0.0.0
CatalogFile = VoxveilApo.cat
PnpLockDown = 1

[Manufacturer]
%MfgName% = ApoComponents,NTamd64.10.0...22621

[ApoComponents.NTamd64.10.0...22621]
%Apo.ComponentDesc% = ApoComponent_Install,SWC\VEN_VXV&CID_APO

[ApoComponent_Install]
CopyFiles = Apo_CopyFiles
AddReg    = Apo_AddReg

[Apo_CopyFiles]
VoxveilApo.dll

[Apo_AddReg]
HKR,Classes\CLSID\%VOXVEIL_SFX_CLSID%,,,%SFX_FriendlyName%
HKR,Classes\CLSID\%VOXVEIL_SFX_CLSID%\InProcServer32,,0x00020000,%13%\VoxveilApo.dll
HKR,Classes\CLSID\%VOXVEIL_SFX_CLSID%\InProcServer32,ThreadingModel,,"Both"

HKR,AudioEngine\AudioProcessingObjects\%VOXVEIL_SFX_CLSID%,"FriendlyName",,%SFX_FriendlyName%
HKR,AudioEngine\AudioProcessingObjects\%VOXVEIL_SFX_CLSID%,"Copyright",,%Copyright%
HKR,AudioEngine\AudioProcessingObjects\%VOXVEIL_SFX_CLSID%,"MajorVersion",0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%VOXVEIL_SFX_CLSID%,"MinorVersion",0x00010001,0
HKR,AudioEngine\AudioProcessingObjects\%VOXVEIL_SFX_CLSID%,"Flags",0x00010001,%APO_FLAG_DEFAULT%
HKR,AudioEngine\AudioProcessingObjects\%VOXVEIL_SFX_CLSID%,"MinInputConnections",0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%VOXVEIL_SFX_CLSID%,"MaxInputConnections",0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%VOXVEIL_SFX_CLSID%,"MinOutputConnections",0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%VOXVEIL_SFX_CLSID%,"MaxOutputConnections",0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%VOXVEIL_SFX_CLSID%,"MaxInstances",0x00010001,0xffffffff
HKR,AudioEngine\AudioProcessingObjects\%VOXVEIL_SFX_CLSID%,"NumAPOInterfaces",0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%VOXVEIL_SFX_CLSID%,"APOInterface0",,"{FD7F2B29-24D0-4B5C-B177-592C39F9CA10}"

[ApoComponent_Install.HW]
AddReg = FriendlyName_AddReg

[FriendlyName_AddReg]
HKR,,FriendlyName,,%Apo.ComponentDesc%

[ApoComponent_Install.Services]
AddService=,2

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
VoxveilApo.dll = 1

[DestinationDirs]
Apo_CopyFiles = 13

[SignatureAttributes]
VoxveilApo.dll = SignatureAttributes.PETrust

[SignatureAttributes.PETrust]
PETrust = true

[Strings]
MfgName           = "Voxveil"
ProviderName      = "Voxveil"
Apo.ComponentDesc = "Voxveil Audio Processing Object"
SFX_FriendlyName  = "Voxveil Vocal Suppression SFX"
Copyright         = "Voxveil contributors"
DiskName          = "Voxveil APO installation media"
VOXVEIL_SFX_CLSID = "{F3F2A99F-8FB7-4B88-949E-448BF8A05221}"
APO_FLAG_DEFAULT  = 0x0000000e
